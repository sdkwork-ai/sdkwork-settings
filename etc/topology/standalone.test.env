# Bootstrap profile standalone.test — replace with application-specific values.
SDKWORK_SETTINGS_DEPLOYMENT_PROFILE=standalone
SDKWORK_SETTINGS_ENVIRONMENT=test
SDKWORK_SETTINGS_PROFILE_ID=standalone.test
SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=https://settings-test.sdkwork.com
SDKWORK_SETTINGS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
VITE_SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SETTINGS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
