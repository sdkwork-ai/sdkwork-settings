# cloud.demo — cloud-hosted independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_settings_demo` and a
# dedicated Redis logical DB index so no cache key collides with another shared-redis environment.
SDKWORK_SETTINGS_DEPLOYMENT_PROFILE=cloud
SDKWORK_SETTINGS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_SETTINGS_PROFILE_ID=cloud.demo
VITE_SDKWORK_SETTINGS_DEPLOYMENT_PROFILE=cloud

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SETTINGS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=https://settings-demo.sdkwork.com
SDKWORK_SETTINGS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=https://settings-demo.sdkwork.com
VITE_SDKWORK_SETTINGS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Dedicated demo PostgreSQL database (see the header above).
SDKWORK_DATABASE_URL=postgresql://sdkwork_settings_demo:changeme@127.0.0.1:5432/sdkwork_settings_demo
SDKWORK_DATABASE_SCHEMA=sdkwork_settings_demo

# Redis isolation: dedicate a logical DB index so hardcoded service prefixes never collide across environments.
SDKWORK_SETTINGS_REDIS_URL=redis://127.0.0.1:6379/15
SDKWORK_SETTINGS_REDIS_ENABLED=true
