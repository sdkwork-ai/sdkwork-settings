# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_settings_demo` and a
# dedicated Redis logical DB index so no shared-redis cache key (rate-limit, session, idempotency)
# ever collides with another shared-redis environment.
SDKWORK_SETTINGS_DEPLOYMENT_PROFILE=standalone
SDKWORK_SETTINGS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_SETTINGS_PROFILE_ID=standalone.demo
VITE_SDKWORK_SETTINGS_DEPLOYMENT_PROFILE=standalone

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SETTINGS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 8080) so a meaningfully distinct
# origin can be published externally for system demonstrations.
SDKWORK_SETTINGS_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18077
SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=http://settings-demo.sdkwork.com:18077
VITE_SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=http://settings-demo.sdkwork.com:18077

# Dedicated demo PostgreSQL database (see the header above).
SDKWORK_DATABASE_URL=postgresql://sdkwork_settings_demo:changeme@127.0.0.1:5432/sdkwork_settings_demo
SDKWORK_DATABASE_SCHEMA=sdkwork_settings_demo

# Redis isolation: point the demo at a dedicated logical DB index on the shared Redis so hardcoded
# service prefixes remain confined to this environment and can never collide with dev/test/staging/prod.
SDKWORK_SETTINGS_REDIS_URL=redis://127.0.0.1:6379/15
SDKWORK_SETTINGS_REDIS_ENABLED=true
SDKWORK_CORS_ALLOWED_ORIGINS=https://settings-demo.sdkwork.com,http://settings-demo.sdkwork.com,https://settings-demo.birdcoder.com,http://settings-demo.birdcoder.com,https://settings-demo.dtupay.com,http://settings-demo.dtupay.com,https://settings-demo.noaper.com,http://settings-demo.noaper.com,https://settings-demo.sdkwork.cn,http://settings-demo.sdkwork.cn,https://settings-demo.birdcoder.cn,http://settings-demo.birdcoder.cn,https://settings-demo.dtupay.cn,http://settings-demo.dtupay.cn,https://settings-demo.noaper.cn,http://settings-demo.noaper.cn,https://settings-demo.skubc.com,http://settings-demo.skubc.com,https://settings-demo.skubc.cn,http://settings-demo.skubc.cn,https://settings-demo.zowalk.com,http://settings-demo.zowalk.com,https://settings-demo.zowalk.cn,http://settings-demo.zowalk.cn,https://settings-demo.offer86.com,http://settings-demo.offer86.com,https://settings-demo.offer86.cn,http://settings-demo.offer86.cn,https://settings-demo.86offer.com,http://settings-demo.86offer.com,https://settings-demo.86offer.cn,http://settings-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
