# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_SETTINGS_DEPLOYMENT_PROFILE=cloud
SDKWORK_SETTINGS_ENVIRONMENT=staging
SDKWORK_SETTINGS_PROFILE_ID=cloud.staging
SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=https://settings-staging.sdkwork.com
SDKWORK_SETTINGS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SETTINGS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

