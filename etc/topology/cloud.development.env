# cloud.development
SDKWORK_SETTINGS_DEPLOYMENT_PROFILE=cloud
SDKWORK_SETTINGS_ENVIRONMENT=development
SDKWORK_SETTINGS_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SETTINGS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_SETTINGS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_SETTINGS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_SETTINGS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_SETTINGS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=https://settings-dev.sdkwork.com,http://settings-dev.sdkwork.com,https://settings-dev.birdcoder.com,http://settings-dev.birdcoder.com,https://settings-dev.dtupay.com,http://settings-dev.dtupay.com,https://settings-dev.noaper.com,http://settings-dev.noaper.com,https://settings-dev.sdkwork.cn,http://settings-dev.sdkwork.cn,https://settings-dev.birdcoder.cn,http://settings-dev.birdcoder.cn,https://settings-dev.dtupay.cn,http://settings-dev.dtupay.cn,https://settings-dev.noaper.cn,http://settings-dev.noaper.cn,https://settings-dev.skubc.com,http://settings-dev.skubc.com,https://settings-dev.skubc.cn,http://settings-dev.skubc.cn,https://settings-dev.zowalk.com,http://settings-dev.zowalk.com,https://settings-dev.zowalk.cn,http://settings-dev.zowalk.cn,https://settings-dev.offer86.com,http://settings-dev.offer86.com,https://settings-dev.offer86.cn,http://settings-dev.offer86.cn,https://settings-dev.86offer.com,http://settings-dev.86offer.com,https://settings-dev.86offer.cn,http://settings-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
